# Nexus Gateway 是 HTTP 源站。局域网直连可使用 0.0.0.0；同机反向代理建议改为 127.0.0.1。
NEXUS_GATEWAY_HOST=0.0.0.0
NEXUS_GATEWAY_PORT=8787

# 外网不要直接暴露此 HTTP 端口；请由 Nginx/Caddy 提供受信任的 HTTPS 域名。
# Gateway 不管理证书，也不会依据 X-Forwarded-* 改写安全判断。

# 首次部署推荐先启动 HTTP 源站，再通过本机或受控局域网打开网页初始化。
# 以下项仅用于无网页环境、旧部署兼容或自动化预配置。
NEXUS_CONFIG_FILE=./data/config.json
NEXUS_BOOTSTRAP_TOKEN_FILE=./data/bootstrap.token

# Hermes 主服务可部署在任意可达设备，不要求与移动网关同机。
HERMES_API_URL=
HERMES_API_TOKEN=

# 程序目录与数据目录分离时可填写绝对路径或挂载路径。
NEXUS_MEDIA_DIR=./data/media
NEXUS_MAX_UPLOAD_BYTES=52428800
NEXUS_MAX_TOTAL_STORAGE_BYTES=10737418240
NEXUS_MIN_FREE_DISK_BYTES=536870912
NEXUS_LOGIN_RATE_LIMIT=5
NEXUS_LOGIN_RATE_WINDOW_SECONDS=60
