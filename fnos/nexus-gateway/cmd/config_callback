#!/bin/bash

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
# shellcheck source=setup_common.sh
. "$SCRIPT_DIR/setup_common.sh"

if [ -n "${wizard_nexus_username:-}" ]; then
  validate_username "$wizard_nexus_username"
fi
if [ -n "${wizard_nexus_password:-}" ]; then
  validate_password "$wizard_nexus_password"
fi
if [ -n "${wizard_hermes_api_url:-}" ]; then
  validate_hermes_url "$wizard_hermes_api_url"
fi

prepare_setup_dir config
[ -z "${wizard_nexus_username:-}" ] || write_setup_field username "$wizard_nexus_username"
[ -z "${wizard_nexus_password:-}" ] || write_setup_field password "$wizard_nexus_password"
[ -z "${wizard_hermes_api_url:-}" ] || write_setup_field hermes_api_url "$wizard_hermes_api_url"
[ -z "${wizard_hermes_api_token:-}" ] || write_setup_field hermes_api_token "$wizard_hermes_api_token"
commit_setup_dir

"$SCRIPT_DIR/main" stop || fail_setup "Nexus configuration was saved but the Gateway could not be stopped"
"$SCRIPT_DIR/main" start || fail_setup "Nexus configuration was saved but the Gateway could not be restarted"
exit 0
